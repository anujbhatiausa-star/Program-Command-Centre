# Copy to .env.local and fill in from Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by scripts/seed.mjs, scripts/create-demo-users.mjs and the
# PM-only "Reset demo data" route. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
